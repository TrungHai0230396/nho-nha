{
  "name": "nho-nha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "db:local": "wrangler d1 migrations apply nho-nha --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astronomy-engine": "^2.1.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
