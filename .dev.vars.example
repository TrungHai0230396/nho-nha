# Local runs only (wrangler dev). Copy to .dev.vars; never commit that file.
# The stand-in for Google answers only on localhost (worker/google.ts).
GOOGLE_CLIENT_ID=local-test-client
GOOGLE_CLIENT_SECRET=local-test-secret
GOOGLE_FAKE=1
# A push key for this machine only: node -e "…" in scripts/chung.sh makes one.
VAPID_KEY=
