{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/*.test.ts",
    "worker/**/*.test.ts",
    "scripts/**/*.test.ts",
    "worker/testing/**/*.ts"
  ]
}
